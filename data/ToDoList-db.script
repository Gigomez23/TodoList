CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.ETIQUETAS(OID VARCHAR(255) NOT NULL PRIMARY KEY,COLOR_ETIQUETA VARCHAR(60) NOT NULL,NOMBRE_ETIQUETA VARCHAR(60) NOT NULL)
CREATE MEMORY TABLE PUBLIC.IMAGES(ID VARCHAR(32) NOT NULL PRIMARY KEY,GALLERY VARCHAR(32),IMAGE VARBINARY(16777216))
CREATE MEMORY TABLE PUBLIC.OXDISCUSSIONCOMMENTS(ID VARCHAR(32) NOT NULL PRIMARY KEY,COMMENT CLOB(16M),DISCUSSIONID VARCHAR(32),TIME TIMESTAMP,USERNAME VARCHAR(30))
CREATE INDEX IDXBHLX4VUNN24YM1TBRLGQ8G30M ON PUBLIC.OXDISCUSSIONCOMMENTS(DISCUSSIONID)
CREATE MEMORY TABLE PUBLIC.TAREA_ETIQUETA(TAREA_OID VARCHAR(255) NOT NULL,ETIQUETA_OID VARCHAR(255) NOT NULL,CONSTRAINT FK7EO7C7G5JLDL0BLW1SBVK5TJK FOREIGN KEY(ETIQUETA_OID) REFERENCES PUBLIC.ETIQUETAS(OID))
CREATE MEMORY TABLE PUBLIC.TAREAS(OID VARCHAR(255) NOT NULL PRIMARY KEY,DESCRIPCION VARCHAR(255),ESTADO VARCHAR(30) NOT NULL,FECHAVENCIMIENTO DATE,PRIORIDAD INTEGER NOT NULL,TITULO VARCHAR(60) NOT NULL,CHECK((PUBLIC.TAREAS.PRIORIDAD<=5) AND (PUBLIC.TAREAS.PRIORIDAD>=1)))
CREATE MEMORY TABLE PUBLIC.TAREAS_RECURRENTES(INTERVALODIAS INTEGER NOT NULL,OID VARCHAR(255) NOT NULL PRIMARY KEY,CHECK((PUBLIC.TAREAS_RECURRENTES.INTERVALODIAS>=1) AND (PUBLIC.TAREAS_RECURRENTES.INTERVALODIAS<=365)),CONSTRAINT FK1AF39392OF8P4EHCW3RKY58NL FOREIGN KEY(OID) REFERENCES PUBLIC.TAREAS(OID))
CREATE MEMORY TABLE PUBLIC.TAREAS_UNICAS(OID VARCHAR(255) NOT NULL PRIMARY KEY,CONSTRAINT FKQH0CFJPKMGPFG3KM03R50XM8E FOREIGN KEY(OID) REFERENCES PUBLIC.TAREAS(OID))
CREATE MEMORY TABLE PUBLIC.TAREAS_URGENTES(HORA_LIMITE TIME,RAZONURGENCIA VARCHAR(255),OID VARCHAR(255) NOT NULL PRIMARY KEY,CONSTRAINT FKCPAB0DDRHTNWAFKJB9B7F1J4B FOREIGN KEY(OID) REFERENCES PUBLIC.TAREAS(OID))
CREATE MEMORY TABLE PUBLIC.REPORTE(DESCRIPCION VARCHAR(50) NOT NULL PRIMARY KEY,CANTIDAD NUMERIC(19,2),FECHA DATE)
ALTER TABLE PUBLIC.TAREA_ETIQUETA ADD CONSTRAINT FKFL0O71NGAQ8TBI3PYC27O9SGQ FOREIGN KEY(TAREA_OID) REFERENCES PUBLIC.TAREAS(OID)
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
